# PostgreSQL (Railway даёт это автоматически)
DATABASE_URL=postgresql://user:password@localhost:5432/zerkalls

# Cloudinary (cloudinary.com → Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# YooKassa (yookassa.ru → Интеграция → Ключи API)
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
# URL возврата после оплаты (по умолчанию — текущий хост)
# RETURN_URL=https://yourdomain.com/

PORT=3001
NODE_ENV=development
